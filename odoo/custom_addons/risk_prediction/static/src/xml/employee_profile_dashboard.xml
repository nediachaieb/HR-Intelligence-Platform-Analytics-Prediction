<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">
 <t t-name="risk_prediction.EmployeeProfileDashboard">

            <div class="o_employee_profile container-fluid p-4">

                <t t-if="state.loading">
                    <div class="text-center py-5">
                        <div class="spinner-border text-primary" role="status">
                            <span class="visually-hidden">Chargement du profil...</span>
                        </div>
                    </div>
                </t>

                <t t-elif="state.error">
                    <div class="alert alert-danger">
                        <t t-esc="state.error"/>
                    </div>
                </t>

                <t t-else="">
                    <div class="d-flex justify-content-between align-items-center mb-4">
                        <h2 class="mb-0">
                            <t t-esc="state.employee.name"/>
                            <small class="text-muted ms-3" t-esc="state.employee.job_title"/>
                        </h2>
                        <button class="btn btn-outline-secondary" t-on-click="backToDashboard">
                            ← Retour au dashboard
                        </button>
                    </div>

                    <div class="row g-4">

                        <!-- Colonne gauche : infos principales -->
                        <div class="col-lg-4">
                            <div class="card shadow-sm mb-4">
                                <div class="card-header">
                                    <h5 class="mb-0">Informations personnelles</h5>
                                </div>
                                <div class="list-group list-group-flush">
                                    <div class="list-group-item d-flex justify-content-between">
                                        <span>Département</span>
                                        <strong t-esc="state.employee.department or '—'"/>
                                    </div>
                                    <div class="list-group-item d-flex justify-content-between">
                                        <span>Genre</span>
                                        <strong t-esc="state.employee.gender == 'male' ? 'Homme' : state.employee.gender == 'female' ? 'Femme' : '—'"/>
                                    </div>
                                    <div class="list-group-item d-flex justify-content-between">
                                        <span>Date de naissance</span>
                                        <strong t-esc="state.employee.birthday or '—'"/>
                                    </div>
                                    <div class="list-group-item d-flex justify-content-between">
                                        <span>Âge</span>
                                        <strong t-esc="state.employee.age"/> ans
                                    </div>
                                </div>
                            </div>

                            <div class="card shadow-sm">
                                <div class="card-header">
                                    <h5 class="mb-0">Situation contractuelle</h5>
                                </div>
                                <div class="list-group list-group-flush">
                                    <div class="list-group-item d-flex justify-content-between">
                                        <span>Statut</span>
                                        <strong t-esc="state.employee.contract_status or '—'"/>
                                    </div>
                                    <div class="list-group-item d-flex justify-content-between">
                                        <span>Salaire mensuel</span>
                                        <strong t-esc="state.employee.monthly_income" />
                                    </div>
                                    <div class="list-group-item d-flex justify-content-between">
                                        <span>Télétravail</span>
                                        <strong t-esc="state.employee.remote_work"/>
                                    </div>
                                </div>
                            </div>
                        </div>

                        <!-- Colonne droite : carrière -->
                        <div class="col-lg-8">
                            <div class="card shadow-sm h-100">
                                <div class="card-header">
                                    <h5 class="mb-0">Parcours professionnel</h5>
                                </div>
                                <div class="card-body">
                                    <div class="row g-4">
                                        <div class="col-md-6">
                                            <div class="border rounded p-3 bg-light">
                                                <h6 class="mb-1">Niveau de poste</h6>
                                                <p class="fs-5 mb-0" t-esc="state.employee.job_level or '—'"/>
                                            </div>
                                        </div>
                                        <div class="col-md-6">
                                            <div class="border rounded p-3 bg-light">
                                                <h6 class="mb-1">Ancienneté entreprise</h6>
                                                <p class="fs-5 mb-0">
                                                    <t t-esc="state.employee.years_at_company"/> années
                                                </p>
                                            </div>
                                        </div>
                                        <div class="col-md-6">
                                            <div class="border rounded p-3 bg-light">
                                                <h6 class="mb-1">Nombre de promotions</h6>
                                                <p class="fs-5 mb-0" t-esc="state.employee.number_of_promotions"/>
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>

                    </div>
                </t>
            </div>

        </t>

</templates>
