<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">

<t t-name="risk_prediction.TurnoverDashboard">


    <!-- ===================================================================== -->
    <!-- TEMPLATE PRINCIPAL : DASHBOARD TURNOVER                               -->
    <!-- ===================================================================== -->
<!--    <template id="TurnoverDashboard" name="Turnover Dashboard">-->
<!--        <t t-name="risk_prediction.TurnoverDashboard">-->

            <div class="o TurnoverDashboard container-fluid p-4">

                <!-- Titre + loader global -->
                <div class="d-flex justify-content-between align-items-center mb-4">
                    <h2 class="mb-0">Tableau de bord Turnover &amp; Risque de départ</h2>
                    <t t-if="state.loading">
                        <div class="spinner-border text-primary" role="status">
                            <span class="visually-hidden">Chargement...</span>
                        </div>
                    </t>
                </div>
                <div class="row mb-4 g-3">

                <!-- Total employés -->
                <div class="col-6 col-md-3 col-lg-2">
                    <div class="card shadow-sm text-center border-primary h-100">
                        <div class="card-body">
                            <h6 class="card-title text-muted mb-1">Total employés</h6>
                            <h3 class="card-text fw-bold text-primary">
                                <t t-esc="state.stats?.total || 0" />
                            </h3>
                        </div>
                    </div>
                </div>

                <!-- Total évalués -->
                <div class="col-6 col-md-3 col-lg-2">
                    <div class="card shadow-sm text-center border-success h-100">
                        <div class="card-body">
                            <h6 class="card-title text-muted mb-1">Total évalués</h6>
                            <h3 class="card-text fw-bold text-success">
                                <t t-esc="state.stats?.evaluated || 0" />
                            </h3>
                        </div>
                    </div>
                </div>

                <!-- Non évalués (undefined) -->
                <div class="col-6 col-md-3 col-lg-2">
                    <div class="card shadow-sm text-center border-warning h-100">
                        <div class="card-body">
                            <h6 class="card-title text-muted mb-1">Non évalués</h6>
                            <h3 class="card-text fw-bold text-warning">
                                <t t-esc="state.stats?.undefined || 0" />
                            </h3>
                        </div>
                    </div>
                </div>
                </div>

                <!-- Ligne 1 : Donut global + statistiques clés -->
                <div class="row mb-4">
                    <div class="col-lg-5 col-xl-4">
                        <div class="card shadow-sm h-100">
                            <div class="card-header">
                                <h5 class="card-title mb-0">Répartition des risques</h5>
                            </div>
                            <div class="card-body p-3">
                                <div class="chart-container" style="position: relative; height: 280px;">
                                    <canvas t-ref="donutChart"></canvas>
                                </div>
                            </div>
                        </div>
                    </div>

                    <div class="col-lg-7 col-xl-8">
                        <div class="row h-100 g-3">
                            <div class="col-12">
                                <div class="card shadow-sm h-100">
                                    <div class="card-header">
                                        <h5 class="card-title mb-0">Risque par département</h5>
                                    </div>
                                    <div class="card-body p-3">
                                        <div class="chart-container" style="position: relative; height: 260px;">
                                            <canvas t-ref="barChart"></canvas>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>

                <!-- Ligne 2 : Évolution temporelle -->
                <div class="row mb-4">
                    <div class="col-12">
                        <div class="card shadow-sm">
                            <div class="card-header">
                                <h5 class="card-title mb-0">Évolution mensuelle des évaluations (12 derniers mois)</h5>
                            </div>
                            <div class="card-body p-3">
                                <div class="chart-container" style="position: relative; height: 320px;">
                                    <canvas t-ref="lineChart"></canvas>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>

                <!-- Modal employés par niveau de risque -->
                <t t-if="state.showModal">
                    <div class="modal fade show" tabindex="-1" style="display: block;">
                        <div class="modal-dialog modal-xl modal-dialog-scrollable">
                            <div class="modal-content">
                                <div class="modal-header">
                                    <h5 class="modal-title">
                                        Employés — Risque
                                        <t t-esc="state.selectedRisk === 'high' ? 'Élevé' : state.selectedRisk === 'medium' ? 'Moyen' : 'Faible'"/>
                                    </h5>
                                    <button type="button" class="btn-close" t-on-click="closeModal"></button>
                                </div>
                                <div class="modal-body p-4" style="max-height: 75vh; overflow-y: auto;">
                                    <div class="table-responsive">
                                        <table class="table table-hover table-sm mb-0">
                                            <thead class="table-light">
                                                <tr>
                                                    <th>Nom</th>
                                                    <th>Département</th>
                                                    <th>Poste</th>
                                                    <th>Dernière éval.</th>
                                                    <th>Actions</th>
                                                </tr>
                                            </thead>
                                            <tbody>
                                                <t t-foreach="state.employees" t-as="emp" t-key="emp.id">
                                                    <tr>
                                                        <td t-esc="emp.name"/>
                                                        <td t-esc="emp.department"/>
                                                        <td t-esc="emp.job_title"/>
                                                        <td>
                                                            <t t-esc="emp.last_evaluation or '—'"/>
                                                        </td>
                                                        <td>
                                                            <button class="btn btn-sm btn-outline-primary me-2"
                                                                    t-on-click="() => this.openEmployee(emp.id)">
                                                                Profil
                                                            </button>
                                                            <button class="btn btn-sm btn-outline-secondary"
                                                                    t-on-click="() => this.openHistory(emp.id)">
                                                                Historique IA
                                                            </button>
                                                        </td>
                                                    </tr>
                                                </t>
                                                <t t-if="!state.employees.length and !state.loading">
                                                    <tr>
                                                        <td colspan="5" class="text-center py-4 text-muted">
                                                            Aucun employé trouvé dans cette catégorie
                                                        </td>
                                                    </tr>
                                                </t>
                                            </tbody>
                                        </table>
                                    </div>
                                </div>
                                <div class="modal-footer">
                                    <button type="button" class="btn btn-secondary" t-on-click="closeModal">Fermer</button>
                                </div>
                            </div>
                        </div>
                    </div>
                    <div class="modal-backdrop fade show"></div>
                </t>
            </div>
        </t>


    <!-- ===================================================================== -->
    <!-- TEMPLATE PROFIL EMPLOYÉ                                               -->
    <!-- ===================================================================== -->

</templates>